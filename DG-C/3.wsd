@startuml Caso-03-Clases
title Registrar Abono

skinparam class {
  BackgroundColor White
  BorderColor Black
  ArrowColor #444444
  FontName Helvetica
}
skinparam classFontStyle bold
skinparam stereotypeCBackgroundColor #DDDDDD

class Usuario {
  -id_usuario : int
  -nombre : String
  -contraseña : String
  +autenticar() 
}

class Dueña {
  +registrarAbono() 
}

class Ayudante {
  +registrarAbono() 
}

class Cliente  {
  -id_cliente : int
  -nombre : String
  -saldo_deudor : double
  -limite_credito: double
  +buscar() 
}

class Abono  {
  -id_abono : int
  -monto : double
  -fecha : Date
  +validarExcedente() 
  +registrar() 
}

class Comprobante  {
  -fecha_emision : DateTime
  -saldo_anterior : double
  -saldo_nuevo : double
  +generar() 
}

Usuario  <|-- Dueña
Usuario  <|-- Ayudante
Cliente  "1" *-- "0..*" Abono      : realiza 
Usuario  "1" --> "0..*" Abono      : registra 
Usuario  "1" --> "0..*" Cliente    : localiza 
Abono    "1" --> "1"    Comprobante : genera 


@enduml